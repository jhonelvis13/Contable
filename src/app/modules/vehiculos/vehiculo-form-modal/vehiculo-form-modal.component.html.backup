<div class="bg-white">
  <!-- Header -->
  <div class="flex items-center justify-between p-6 border-b border-gray-200">
    <h3 class="text-lg font-medium text-gray-900">
      {{ isEditing ? 'Editar Vehículo' : 'Nuevo Vehículo' }}
    </h3>
    <button
      (click)="onCancel()"
      class="text-gray-400 hover:text-gray-600 focus:outline-none">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Form -->
  <form [formGroup]="vehiculoForm" (ngSubmit)="onSubmit()" class="p-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- Información Básica -->
      <div class="md:col-span-2">
        <h4 class="text-md font-medium text-gray-900 mb-4">Información del Vehículo</h4>
      </div>

      <!-- Placa -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Placa <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          formControlName="placa"
          placeholder="Ej: BOL-1234"
          [class]="'w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 ' + 
                   (isFieldInvalid('placa') ? 'border-red-300 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500')">
        <p *ngIf="getFieldError('placa')" class="mt-1 text-sm text-red-600">
          {{ getFieldError('placa') }}
        </p>
      </div>

      <!-- Marca -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Marca <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          formControlName="marca"
          placeholder="Ej: Toyota"
          [class]="'w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 ' + 
                   (isFieldInvalid('marca') ? 'border-red-300 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500')">
        <p *ngIf="getFieldError('marca')" class="mt-1 text-sm text-red-600">
          {{ getFieldError('marca') }}
        </p>
      </div>

      <!-- Modelo -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Modelo <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          formControlName="modelo"
          placeholder="Ej: HiAce"
          [class]="'w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 ' + 
                   (isFieldInvalid('modelo') ? 'border-red-300 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500')">
        <p *ngIf="getFieldError('modelo')" class="mt-1 text-sm text-red-600">
          {{ getFieldError('modelo') }}
        </p>
      </div>

      <!-- Año -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Año <span class="text-red-500">*</span>
        </label>
        <input
          type="number"
          formControlName="year"
          placeholder="2020"
          [min]="1990"
          [max]="currentYear + 1"
          [class]="'w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 ' + 
                   (isFieldInvalid('year') ? 'border-red-300 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500')">
        <p *ngIf="getFieldError('year')" class="mt-1 text-sm text-red-600">
          {{ getFieldError('year') }}
        </p>
      </div>

      <!-- Tipo -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Tipo <span class="text-red-500">*</span>
        </label>
        <select
          formControlName="tipo"
          [class]="'w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 ' + 
                   (isFieldInvalid('tipo') ? 'border-red-300 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500')">
          <option value="">Seleccionar tipo</option>
          <option *ngFor="let tipo of tipos" [value]="tipo">{{ tipo }}</option>
        </select>
        <p *ngIf="getFieldError('tipo')" class="mt-1 text-sm text-red-600">
          {{ getFieldError('tipo') }}
        </p>
      </div>

      <!-- Capacidad -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Capacidad (pasajeros) <span class="text-red-500">*</span>
        </label>
        <input
          type="number"
          formControlName="capacidad"
          placeholder="14"
          min="1"
          [class]="'w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 ' + 
                   (isFieldInvalid('capacidad') ? 'border-red-300 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500')">
        <p *ngIf="getFieldError('capacidad')" class="mt-1 text-sm text-red-600">
          {{ getFieldError('capacidad') }}
        </p>
      </div>

      <!-- Color -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Color <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          formControlName="color"
          placeholder="Ej: Blanco"
          [class]="'w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 ' + 
                   (isFieldInvalid('color') ? 'border-red-300 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500')">
        <p *ngIf="getFieldError('color')" class="mt-1 text-sm text-red-600">
          {{ getFieldError('color') }}
        </p>
      </div>

      <!-- Estado -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Estado <span class="text-red-500">*</span>
        </label>
        <select
          formControlName="estado"
          [class]="'w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 ' + 
                   (isFieldInvalid('estado') ? 'border-red-300 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500')">
          <option *ngFor="let estado of estados" [value]="estado">{{ estado }}</option>
        </select>
        <p *ngIf="getFieldError('estado')" class="mt-1 text-sm text-red-600">
          {{ getFieldError('estado') }}
        </p>
      </div>

      <!-- Información del Seguro -->
      <div class="md:col-span-2 mt-6">
        <h4 class="text-md font-medium text-gray-900 mb-4">Información del Seguro</h4>
      </div>

      <div formGroupName="seguro" class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Compañía de Seguro -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Compañía <span class="text-red-500">*</span>
          </label>
          <select
            formControlName="compania"
            [class]="'w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 ' + 
                     (isFieldInvalid('seguro', 'compania') ? 'border-red-300 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500')">
            <option value="">Seleccionar compañía</option>
            <option *ngFor="let compania of companias" [value]="compania">{{ compania }}</option>
          </select>
          <p *ngIf="getFieldError('seguro', 'compania')" class="mt-1 text-sm text-red-600">
            {{ getFieldError('seguro', 'compania') }}
          </p>
        </div>

        <!-- Número de Póliza -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Número de Póliza <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            formControlName="numero"
            placeholder="SO-123456789"
            [class]="'w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 ' + 
                     (isFieldInvalid('seguro', 'numero') ? 'border-red-300 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500')">
          <p *ngIf="getFieldError('seguro', 'numero')" class="mt-1 text-sm text-red-600">
            {{ getFieldError('seguro', 'numero') }}
          </p>
        </div>

        <!-- Fecha de Vencimiento del Seguro -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Fecha de Vencimiento <span class="text-red-500">*</span>
          </label>
          <input
            type="date"
            formControlName="fechaVencimiento"
            [class]="'w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 ' + 
                     (isFieldInvalid('seguro', 'fechaVencimiento') ? 'border-red-300 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500')">
          <p *ngIf="getFieldError('seguro', 'fechaVencimiento')" class="mt-1 text-sm text-red-600">
            {{ getFieldError('seguro', 'fechaVencimiento') }}
          </p>
        </div>

        <!-- Monto del Seguro -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Monto (Bs.) <span class="text-red-500">*</span>
          </label>
          <input
            type="number"
            formControlName="monto"
            placeholder="150"
            min="0"
            step="0.01"
            [class]="'w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 ' + 
                     (isFieldInvalid('seguro', 'monto') ? 'border-red-300 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500')">
          <p *ngIf="getFieldError('seguro', 'monto')" class="mt-1 text-sm text-red-600">
            {{ getFieldError('seguro', 'monto') }}
          </p>
        </div>
      </div>

      <!-- Información de Revisión Técnica -->
      <div class="md:col-span-2 mt-6">
        <h4 class="text-md font-medium text-gray-900 mb-4">Revisión Técnica</h4>
      </div>

      <div formGroupName="revisionTecnica" class="md:col-span-2 grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Número de Revisión -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Número <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            formControlName="numero"
            placeholder="RT-987654321"
            [class]="'w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 ' + 
                     (isFieldInvalid('revisionTecnica', 'numero') ? 'border-red-300 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500')">
          <p *ngIf="getFieldError('revisionTecnica', 'numero')" class="mt-1 text-sm text-red-600">
            {{ getFieldError('revisionTecnica', 'numero') }}
          </p>
        </div>

        <!-- Fecha de Vencimiento -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Fecha de Vencimiento <span class="text-red-500">*</span>
          </label>
          <input
            type="date"
            formControlName="fechaVencimiento"
            [class]="'w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 ' + 
                     (isFieldInvalid('revisionTecnica', 'fechaVencimiento') ? 'border-red-300 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500')">
          <p *ngIf="getFieldError('revisionTecnica', 'fechaVencimiento')" class="mt-1 text-sm text-red-600">
            {{ getFieldError('revisionTecnica', 'fechaVencimiento') }}
          </p>
        </div>

        <!-- Estado de Revisión -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Estado <span class="text-red-500">*</span>
          </label>
          <select
            formControlName="estado"
            [class]="'w-full px-3 py-2 border rounded-md focus:outline-none focus:ring-1 ' + 
                     (isFieldInvalid('revisionTecnica', 'estado') ? 'border-red-300 focus:ring-red-500' : 'border-gray-300 focus:ring-blue-500')">
            <option *ngFor="let estado of estadosRevision" [value]="estado">{{ estado }}</option>
          </select>
          <p *ngIf="getFieldError('revisionTecnica', 'estado')" class="mt-1 text-sm text-red-600">
            {{ getFieldError('revisionTecnica', 'estado') }}
          </p>
        </div>
      </div>

      <!-- Observaciones -->
      <div class="md:col-span-2 mt-6">
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Observaciones
        </label>
        <textarea
          formControlName="observaciones"
          rows="3"
          placeholder="Información adicional sobre el vehículo..."
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-500 resize-none">
        </textarea>
      </div>
    </div>

    <!-- Botones -->
    <div class="flex justify-end space-x-3 mt-8 pt-6 border-t border-gray-200">
      <button
        type="button"
        (click)="onCancel()"
        class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
        Cancelar
      </button>
      <button
        type="submit"
        [disabled]="vehiculoForm.invalid || isLoading"
        class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed flex items-center">
        <svg *ngIf="isLoading" class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        {{ isLoading ? 'Guardando...' : (isEditing ? 'Actualizar' : 'Crear') }}
      </button>
    </div>
  </form>
</div>